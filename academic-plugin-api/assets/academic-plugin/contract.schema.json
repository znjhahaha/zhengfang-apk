{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zfplugin.local/api/1/contract.schema.json",
  "apiVersion": 1,
  "methods": {
    "auth.start": "AuthState",
    "auth.resume": "AuthState",
    "auth.refreshCaptcha": "AuthState",
    "auth.validate": "AuthState",
    "study.terms": "Terms",
    "study.schedule": "Schedule",
    "study.calendar": "Calendar",
    "study.grades": "Grades",
    "study.gradeDetails": "GradeDetails",
    "study.exams": "Exams",
    "selection.catalog": "Rounds",
    "selection.courses": "Courses",
    "selection.sections": "Sections",
    "selection.enrolled": "Enrollments",
    "selection.select": "SelectionReceipt",
    "selection.drop": "SelectionReceipt"
  },
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNSUPPORTED",
            "NOT_OPEN",
            "INVALID_CREDENTIALS",
            "SESSION_EXPIRED",
            "CAPTCHA_REQUIRED",
            "WEB_LOGIN_REQUIRED",
            "NO_CAPACITY",
            "CONFLICT",
            "ALREADY_SELECTED",
            "CREDIT_LIMIT",
            "PAGE_CHANGED",
            "NETWORK_RETRYABLE",
            "RESULT_UNKNOWN",
            "UNTRUSTED_URL",
            "VALIDATION_FAILED",
            "TIMEOUT",
            "CANCELLED",
            "RUNTIME_EXITED",
            "RESOURCE_LIMIT",
            "BAD_SIGNATURE"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "Term": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2300
        },
        "semester": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "order": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        },
        "nextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Terms": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          },
          "maxItems": 1000
        },
        "currentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "items",
        "currentId"
      ],
      "additionalProperties": false
    },
    "AuthState": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "authenticated"
            },
            "studentId": {
              "type": "string"
            },
            "studentName": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "studentId",
            "studentName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "captcha"
            },
            "continuationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "imageBase64": {
              "type": "string",
              "maxLength": 1400000
            },
            "mimeType": {
              "type": "string",
              "enum": [
                "image/png",
                "image/jpeg",
                "image/gif",
                "image/webp"
              ]
            }
          },
          "required": [
            "status",
            "continuationId",
            "imageBase64",
            "mimeType"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "webLogin"
            },
            "continuationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "completionUrl": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "status",
            "continuationId",
            "url",
            "completionUrl"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ScheduleEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "teacher": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "startPeriod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "endPeriod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "weeks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "maxItems": 25
        }
      },
      "required": [
        "id",
        "name",
        "day",
        "startPeriod",
        "endPeriod",
        "weeks"
      ],
      "additionalProperties": false
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "termId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScheduleEntry"
          },
          "maxItems": 10000
        },
        "maxWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "termId",
        "entries",
        "maxWeeks"
      ],
      "additionalProperties": false
    },
    "Calendar": {
      "type": "object",
      "properties": {
        "termId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startDate": {
          "type": "string"
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "start": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^[0-2][0-9]:[0-5][0-9]$"
              }
            },
            "required": [
              "number",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        }
      },
      "required": [
        "termId",
        "periods"
      ],
      "additionalProperties": false
    },
    "Grade": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
