{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zfplugin.local/api/1/manifest.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,95}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "apiVersion": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "configuration",
        "extension",
        "independent"
      ]
    },
    "extends": {
      "type": "string",
      "enum": [
        "builtin.zf",
        "builtin.zf_old",
        "builtin.qz",
        "builtin.qz_old",
        "builtin.legacy_zf"
      ]
    },
    "entry": {
      "const": "index.js"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "auth.start",
          "auth.resume",
          "auth.refreshCaptcha",
          "auth.validate",
          "study.terms",
          "study.schedule",
          "study.calendar",
          "study.grades",
          "study.gradeDetails",
          "study.exams",
          "selection.catalog",
          "selection.courses",
          "selection.sections",
          "selection.enrolled",
          "selection.select",
          "selection.drop"
        ]
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 300
          },
          "pathPrefix": {
            "type": "string",
            "pattern": "^/"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "GET",
                "POST"
              ]
            },
            "maxItems": 2
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "query",
                "auth",
                "mutation"
              ]
            },
            "maxItems": 3
          },
          "requiredQuery": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "requiredForm": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "origin",
          "pathPrefix",
          "methods",
          "purposes"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "school": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "protocol": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "basePath": {
          "type": "string"
        },
        "academicSystem": {
          "type": "string"
        },
        "allowedAcademicHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "pageCharset": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "protocol",
        "basePath"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "kind",
    "capabilities",
    "network",
    "school",
    "files"
  ],
  "additionalProperties": false
}
