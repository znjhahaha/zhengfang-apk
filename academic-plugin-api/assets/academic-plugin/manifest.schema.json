{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zfplugin.local/api/3/manifest.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,95}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "apiVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "configuration",
        "extension",
        "independent",
        "service"
      ]
    },
    "extends": {
      "type": "string",
      "enum": [
        "builtin.zf",
        "builtin.zf_old",
        "builtin.qz",
        "builtin.qz_old",
        "builtin.legacy_zf"
      ]
    },
    "entry": {
      "const": "index.js"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "auth.start",
          "auth.resume",
          "auth.refreshCaptcha",
          "auth.validate",
          "study.terms",
          "study.schedule",
          "study.calendar",
          "study.grades",
          "study.gradeDetails",
          "study.exams",
          "selection.catalog",
          "selection.courses",
          "selection.sections",
          "selection.enrolled",
          "selection.select",
          "selection.drop",
          "service.page",
          "service.action"
        ]
      },
      "maxItems": 18,
      "uniqueItems": true
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 300
          },
          "pathPrefix": {
            "type": "string",
            "pattern": "^/"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "GET",
                "POST"
              ]
            },
            "maxItems": 2
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "query",
                "auth",
                "mutation"
              ]
            },
            "maxItems": 3
          },
          "requiredQuery": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "requiredForm": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "origin",
          "pathPrefix",
          "methods",
          "purposes"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "school": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "protocol": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "basePath": {
          "type": "string"
        },
        "academicSystem": {
          "type": "string"
        },
        "allowedAcademicHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "pageCharset": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "protocol",
        "basePath"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "schoolIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 30,
          "minItems": 1,
          "uniqueItems": true
        },
        "academicHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "authentication": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "password"
              ]
            },
            "usernameLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "passwordLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "help": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "maxItems": 12,
          "minItems": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "pageId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "icon": {
                "type": "string",
                "enum": [
                  "school",
                  "book",
                  "chart",
                  "calendar",
                  "wallet",
                  "activity"
                ]
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "placements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "home",
                    "schedule",
                    "grades"
                  ]
                },
                "maxItems": 3,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "title",
              "pageId",
              "icon",
              "order"
            ],
            "additionalProperties": false
          },
          "maxItems": 12,
          "minItems": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "query",
                  "mutation"
                ]
              },
              "confirmation": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "title",
              "kind"
            ],
            "additionalProperties": false
          },
          "maxItems": 40
        },
        "nativeOperations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "scanCode",
                  "pickFile",
                  "notification",
                  "calendar"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "resultActionId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "mimeTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "text/plain",
                    "text/csv",
                    "application/json",
                    "application/pdf",
                    "image/png",
                    "image/jpeg"
                  ]
                },
                "maxItems": 6,
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "reason",
              "resultActionId"
            ],
            "additionalProperties": false
          },
          "maxItems": 12
        }
      },
      "required": [
        "schoolIds",
        "authentication",
        "pages",
        "entries",
        "actions"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "kind",
    "capabilities",
    "network",
    "school",
    "files"
  ],
  "additionalProperties": false
}
