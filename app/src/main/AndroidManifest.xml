<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="org.mozilla.geckoview" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    
    <!-- 后台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 定时任务权限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- 应用更新权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".CourseApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CourseSelector"
        tools:targetApi="31">
        <activity android:name=".schedule.ScheduleWidgetAppearanceActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".diagnostics.ErrorReportActivity" android:exported="false" android:theme="@style/Theme.CourseSelector" />
        <activity android:name=".academic.plugin.NativePluginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".academic.plugin.PluginUserscriptActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".academic.plugin.PluginEmbeddedBrowserActivity" android:exported="false" android:process=":plugin_embedded_browser" android:windowSoftInputMode="adjustResize" />
        <service android:name=".academic.plugin.PluginEmbeddedBrowserService" android:exported="false" android:process=":plugin_embedded_browser" />
        <activity android:name=".academic.plugin.PluginLegacyWebActivity" android:exported="false" android:process=":plugin_legacy_web" android:configChanges="orientation|screenSize|keyboardHidden|uiMode" android:windowSoftInputMode="adjustResize" />
        <service android:name=".academic.plugin.PluginLegacyWebService" android:exported="false" android:process=":plugin_legacy_web" />
        <service android:name=".academic.plugin.PluginForegroundService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".academic.plugin.NativePluginJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".academic.plugin.PluginUpdateJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />

        <provider
            android:name=".manager.AppearanceThemeProvider"
            android:authorities="${applicationId}.appearance"
            android:exported="false" />
        
        <!-- 手机竖屏/大屏自由方向由 Activity 在运行时读取窗口资源决定。
             Manifest 不能引用带 sw600dp 等尺寸变体的 screenOrientation 资源。 -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.CourseSelector.Starting"
            android:configChanges="uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:theme="@style/Theme.CourseSelector.Starting"
            android:configChanges="uiMode"
            android:exported="false" />
        <activity
            android:name=".CookieWebViewActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AcademicWebViewActivity"
            android:configChanges="uiMode"
            android:process=":academic_webview"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CourseDetailActivity" android:exported="false" android:configChanges="uiMode" />
        <activity
            android:name=".SurveyWebViewActivity"
            android:exported="false"
            android:configChanges="uiMode"
            android:windowSoftInputMode="adjustResize" />
        
        <activity android:name=".ui.system.GlassBrowserPreviewActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".academic.plugin.PluginCenterActivity" android:exported="false" android:configChanges="uiMode" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".academic.plugin.PluginDeveloperActivity" android:exported="false" android:configChanges="uiMode" />
        <activity android:name=".academic.plugin.CampusServiceCenterActivity" android:exported="false" android:configChanges="uiMode" />
        <activity android:name=".academic.plugin.ServicePluginActivity" android:exported="false" android:configChanges="uiMode" />
        <service android:name=".update.UpdateDownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".update.UpdateDownloadActivity" android:exported="false" />
        <!-- Background grab service -->
        <!-- #30/#50: keep a private separate process; isolated UID startup fails on some OEMs.
             QuickJS/host checks remain, but this no longer provides OS-level UID isolation. -->
        <service
            android:name=".academic.plugin.runtime.PluginSandboxService"
            android:process=":academic_plugin"
            android:exported="false" />
        <service
            android:name=".service.GrabService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- Scheduled grab alarm receiver -->
        <receiver android:name=".schedule.ScheduleWidgetProvider" android:exported="false" android:label="@string/schedule_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget_info" />
        </receiver>
        <receiver android:name=".schedule.ScheduleSingleWidgetProvider" android:label="@string/schedule_widget_single_name" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget_single_info" />
        </receiver>
        <receiver android:name=".schedule.ScheduleTimelineWidgetProvider" android:label="@string/schedule_widget_timeline_name" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget_timeline_info" />
        </receiver>
        <receiver android:name=".schedule.CourseReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.GrabAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tyust.course.action.SCHEDULED_GRAB" />
            </intent-filter>
        </receiver>
        
        <!-- FileProvider for sharing iCal files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
    </application>

</manifest>
