<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
    <TextView android:id="@+id/widget_timeline_time" style="@style/ScheduleWidgetMetadata"
        android:layout_width="wrap_content" android:minWidth="42dp" android:textSize="12sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="16dp" android:layout_height="40dp">
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="center"
            android:background="#30536078" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_timeline_dot" android:layout_width="5dp" android:layout_height="5dp"
            android:layout_gravity="center" android:background="#345DC4" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="4dp">
        <TextView android:id="@+id/widget_name" style="@style/ScheduleWidgetCourseName" android:textSize="14sp" />
        <TextView android:id="@+id/widget_location" style="@style/ScheduleWidgetMetadata" android:layout_marginTop="3dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" style="@style/ScheduleWidgetMetadata"
        android:layout_width="wrap_content" android:paddingStart="6dp" />
</LinearLayout>
